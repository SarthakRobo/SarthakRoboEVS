<!<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SarthakRobo EVS Class V2</title>
    <style>
        body { 
            font-family: Arial, sans-serif; background-color: #f4f7f6; 
            text-align: center; padding: 20px; color: #0000FF;
        }
        #header { font-size: 28px; font-weight: bold; color: #333; margin-bottom: 20px; }
        
        /* Robot Animation CSS */
        #robot { font-size: 80px; margin-bottom: 20px; transition: all 0.3s ease; }
        .talking { animation: bounceGlow 0.5s infinite alternate; }
        @keyframes bounceGlow {
            0% { transform: scale(1) translateY(0); text-shadow: 0 0 10px #007bff; }
            100% { transform: scale(1.1) translateY(-10px); text-shadow: 0 0 30px #28a745; }
        }

        #slide-container { 
            background: white; padding: 40px; border-radius: 10px; 
            border: 2px solid red; border-left: 8px solid red; 
            box-shadow: 0px 4px 15px rgba(0,0,0,0.1); max-width: 800px; 
            margin: auto; min-height: 250px; display: none;
        }        
        h1 { color: #d9534f; font-size: 26px; }
        #answer { font-size: 22px; line-height: 1.6; color: #0000FF; font-weight: bold; display: none; margin-top:20px; }
        
        .btn { 
            padding: 15px 30px; font-size: 20px; margin: 10px; cursor: pointer; 
            border: none; border-radius: 8px; font-weight: bold; color: white;
        }
        .btn:disabled { background-color: #cccccc; cursor: not-allowed; }
        
        #startBtn { background-color: #28a745; font-size: 24px; padding: 20px 40px; }
        #actionBtn { background-color: #ff9800; font-size: 22px; width: 100%; margin-top:20px; }
        .nav-btn { background-color: #007bff; }
        .controls { margin-top: 30px; display: flex; justify-content: space-between; }
    </style>
</head>
<body>

    <div id="header">🤖 SarthakRobo EVS Teacher</div>
    
    <button id="startBtn" onclick="startClass()">▶ क्लास शुरू करें</button>

    <div id="slide-container">
        <!-- Robot Icon -->
        <div id="robot">🤖</div>
        
        <h1 id="question">लोड हो रहा है...</h1>
        
        <!-- Answer and Action Button -->
        <button id="actionBtn" onclick="showAnswerAndPlay()">Show Answer & Play Audio</button>
        <p id="answer"></p>
        
        <div class="controls">
            <button id="prevBtn" class="btn nav-btn" onclick="changeSlide(-1)">◀ पिछला</button>
            
            <!-- Auto Play Toggle Button -->
            <label style="font-size: 18px; color:#333; margin-top: 15px;">
                <input type="checkbox" id="autoPlayToggle" checked> Auto-Advance (ऑटो-प्ले)
            </label>
            
            <button id="nextBtn" class="btn nav-btn" onclick="changeSlide(1)">अगला ▶</button>
        </div>
    </div>

    <audio id="audioPlayer" style="display:none;"></audio>

    <script>
        let currentSlide = 1;
        const totalSlides = {{ total_slides }};
        const audioPlayer = document.getElementById("audioPlayer");
        const robotIcon = document.getElementById("robot");

        function startClass() {
            document.getElementById("startBtn").style.display = "none";
            document.getElementById("slide-container").style.display = "block";
            loadSlide(currentSlide);
        }

        function loadSlide(slideNum) {
            // Audio band karo aur animation roko naya slide aate hi
            audioPlayer.pause();
            audioPlayer.currentTime = 0;
            robotIcon.classList.remove("talking");

            fetch(`/get_slide/${slideNum}`)
                .then(response => response.json())
                .then(data => {
                    if(data.error) return;
                    document.getElementById("question").innerText = data.question;
                    document.getElementById("answer").innerText = data.answer;
                    audioPlayer.src = data.audio;
                    
                    // Reset UI for Quiz Mode
                    document.getElementById("answer").style.display = "none";
                    document.getElementById("actionBtn").style.display = "block";
                    
                    document.getElementById("prevBtn").disabled = (slideNum === 1);
                    document.getElementById("nextBtn").disabled = (slideNum === totalSlides);
                });
        }

        function showAnswerAndPlay() {
            document.getElementById("answer").style.display = "block";
            document.getElementById("actionBtn").style.display = "none";
            audioPlayer.play();
        }

        // Animation logic
        audioPlayer.onplay = function() {
            robotIcon.classList.add("talking");
        };
        audioPlayer.onpause = function() {
            robotIcon.classList.remove("talking");
        };
        
        // Auto-Advance logic
        audioPlayer.onended = function() {
            robotIcon.classList.remove("talking");
            let isAuto = document.getElementById("autoPlayToggle").checked;
            if(isAuto && currentSlide < totalSlides) {
                // Thoda ruk kar next slide par jaye
                setTimeout(() => { changeSlide(1); }, 1500);
            }
        };

        function changeSlide(step) {
            let newSlide = currentSlide + step;
            if(newSlide >= 1 && newSlide <= totalSlides) {
                currentSlide = newSlide;
                loadSlide(currentSlide);
            }
        }
    </script>
</body>
</html><!
